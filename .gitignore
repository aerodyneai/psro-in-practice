__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/
.coverage
build/
dist/
# Experiment outputs under experiments/*/figures/ are scratch — regenerated by
# every non-smoke run and never shipped with the book. Book-ready renders live
# in docs/figures/ (versioned) and are produced by
# `python experiments/chXX/run_chXX.py --plot-only --figdir docs/figures/`.
experiments/*/figures/*.png
experiments/*/figures/*.pdf
# --smoke outputs (CI runs must never touch the tracked results/ CSVs)
experiments/*/results_smoke/
experiments/*/figures_smoke/
